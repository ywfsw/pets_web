{
  "name": "pets-web-sukki",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-24",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "npm run build:cloudflare" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "routes": [
    { "pattern": "sukki.pp.ua", "custom_domain": true }
  ]
}
